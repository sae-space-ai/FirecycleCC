# APILayer API Keys
# Obtén tus keys en: https://apilayer.com/

# IPStack - Geolocalización por IP
VITE_IPSTACK_API_KEY=tu_ipstack_key_aqui

# PositionStack - Geocoding (direcciones a coordenadas)
VITE_POSITIONSTACK_API_KEY=tu_positionstack_key_aqui

# WeatherStack - Datos meteorológicos
VITE_WEATHERSTACK_API_KEY=tu_weatherstack_key_aqui

# AviationStack - Datos de aviación
VITE_AVIATIONSTACK_API_KEY=tu_aviationstack_key_aqui

# MediaStack - Noticias
VITE_MEDIASTACK_API_KEY=tu_mediastack_key_aqui

# CountryLayer - Información de países
VITE_COUNTRYLAYER_API_KEY=tu_countrylayer_key_aqui
